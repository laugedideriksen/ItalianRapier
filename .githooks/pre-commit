#!/usr/bin/env bash
# Keeps labels.json in sync with the labels defined in the .typ source.
# can never be stale in a commit. Enable once per clone with:
#   git config core.hooksPath .githooks
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

changed=$(git diff --cached --name-only --diff-filter=ACMRD)
grep -qE '\.typ$' <<<"$changed" || exit 0

if ! scripts/labels.sh; then
    echo "pre-commit: scripts/labels.sh failed, commit aborted (fix the above, or bypass with --no-verify)" >&2
    exit 1
fi
git add labels.json
